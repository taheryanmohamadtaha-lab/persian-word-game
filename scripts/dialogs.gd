static func character() -> String:
	var game = (Engine.get_main_loop() as SceneTree).root.get_node("Game")
	var c: String = game.settings.get("character", "kolah")
	return c if CHARS.has(c) else "kolah"

static func line(key: String, ch: String = "") -> String:
	var c := ch if ch != "" else character()
	var arr: Array = CHARS[c].get(key, CHARS["kolah"][key])
	return str(arr.pick_random())

static func char_name(ch: String) -> String:
	return CHARS[ch]["name"]
