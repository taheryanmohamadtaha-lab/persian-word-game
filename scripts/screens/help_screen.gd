extends Screen

func build() -> void:
	main.bg.set_palette(3)
	back_button("start")
	title_bar("راهنمای بازی")
	var p := UI.panel(self, Vector2(x(30), 110), Vector2(660, minf(1060.0, H - 150.0)), UI.CREAM, 28, UI.GOLD, 4)
	var text := "۱. سرنخ بالای صفحه را بخوان و حرف‌ها را بدون ترتیب لمس کن. هر حرف درست، همهٔ خانه‌هایی را که آن حرف در کلمه دارد پر می‌کند.\n\n۲. هر حرفی که در کلمه نیست، یک گوی شیشه‌ای را می‌شکند. آسان ۶ گوی، متوسط و سخت ۵ گوی دارند.\n\n۳. اگر همهٔ گوی‌ها بشکنند، مرحله از اول شروع می‌شود.\n\n۴. «راهنما» با پنج سکه یک حرف درست را می‌گذارد و نکته‌ای می‌گوید. «عبور» سؤال را رد می‌کند و ده امتیاز کم می‌کند.\n\n۵. پاسخ سریع و بدون اشتباه امتیاز بیشتری دارد.\n\n۶. گروه سنی و سطح دشواری دو انتخاب جدا هستند. در سطح سخت برای هر سؤال ۶۰ ثانیه وقت داری و با تمام شدن وقت یک گوی می‌شکند.\n\n۷. با هر مرحله ستاره و سکه می‌گیری و مرحلهٔ بعد باز می‌شود. اطلاعات خودکار ذخیره می‌شود."
	var l := UI.label(p, text, Vector2(24, 16), p.size - Vector2(48, 32), 28, UI.INK, HORIZONTAL_ALIGNMENT_RIGHT)
	l.vertical_alignment = VERTICAL_ALIGNMENT_TOP
