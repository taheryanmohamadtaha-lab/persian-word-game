extends Screen

func build() -> void:
	main.bg.set_palette(3)
	back_button("start")
	title_bar("راهنمای بازی")
	var p := UI.panel(self, Vector2(x(30), 110), Vector2(660, minf(1060.0, H - 150.0)), UI.CREAM, 28, UI.GOLD, 4)
	var text := "۱. سرنخ بالای صفحه را بخوان و با لمس حرف‌ها پاسخ را در خانه‌ها بساز.\n\n۲. «حذف حرف» آخرین حرف را برمی‌دارد و «پاک‌کردن» همهٔ حرف‌ها را.\n\n۳. «راهنما» با پنج سکه یک حرف درست را می‌گذارد و نکته‌ای می‌گوید.\n\n۴. «عبور» سؤال را رد می‌کند و ده امتیاز از مرحله کم می‌کند.\n\n۵. پاسخ سریع، بدون راهنما و پشت‌سرهم، امتیاز بیشتری دارد.\n\n۶. گروه سنی و سطح دشواری دو انتخاب جدا هستند. در سطح سخت برای هر سؤال ۶۰ ثانیه وقت داری.\n\n۷. با هر مرحله ستاره و سکه می‌گیری و مرحلهٔ بعد باز می‌شود.\n\n۸. همهٔ اطلاعات خودکار روی گوشی ذخیره می‌شود. اگر گوشی‌ات صدای فارسی داشته باشد، دوستت حرف هم می‌زند."
	var l := UI.label(p, text, Vector2(24, 16), p.size - Vector2(48, 32), 28, UI.INK, HORIZONTAL_ALIGNMENT_RIGHT)
	l.vertical_alignment = VERTICAL_ALIGNMENT_TOP
